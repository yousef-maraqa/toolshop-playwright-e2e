# Target environment: prod, with-bugs, sprint4, or local
ENV=prod
AUTH_ROLES=customer

# Admin credentials for admin-only tests (admin cannot be self-registered).
TEST_ADMIN_EMAIL=admin@practicesoftwaretesting.com
TEST_ADMIN_PASSWORD=welcome01

# Customer credentials are only a fallback: global setup registers a fresh,
# unique customer per run so the shared demo account cannot lock it out (HTTP 423).
TEST_CUSTOMER_EMAIL=customer@practicesoftwaretesting.com
TEST_CUSTOMER_PASSWORD=welcome01
